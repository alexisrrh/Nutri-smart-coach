
PORT=3000

# Public frontend origin used by CORS in production.
FRONTEND_URL=https://tu-frontend.vercel.app

# IA
GEMINI_API_KEY=your_gemini_api_key

# Google Play Billing
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Apple In-App Purchase
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=sandbox

# Supabase admin backend only. Never expose this key in Vite/frontend env vars.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional comma-separated extra origins for custom domains or Vercel previews.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-preview.vercel.app
